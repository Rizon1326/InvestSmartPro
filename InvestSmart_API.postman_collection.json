                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.collectionVariables.set('business_id', jsonData.id);",
                                    "console.log('Business ID saved:', jsonData.id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Dhaka Coffee House\",\n    \"description\": \"A modern coffee shop in Gulshan area targeting young professionals and students. Will serve premium coffee, pastries, and light snacks with free WiFi.\",\n    \"initial_investment\": 500000,\n    \"monthly_revenue\": 150000,\n    \"monthly_expenses\": 80000,\n    \"category_id\": 2\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/business-ideas/",
                            "host": ["{{base_url}}"],
                            "path": ["business-ideas", ""]
                        },
                        "description": "Create a new business idea with AI analysis. Required fields: name, description, initial_investment, monthly_revenue, monthly_expenses. Optional: category_id (1-10)"
                    },
                    "response": []
                },
                {
                    "name": "Create Business Idea (Minimal)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.collectionVariables.set('business_id', jsonData.id);",
                                    "console.log('Business ID saved:', jsonData.id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Tea Stall\",\n    \"description\": \"Small tea stall near office area\",\n    \"initial_investment\": 50000,\n    \"monthly_revenue\": 30000,\n    \"monthly_expenses\": 15000\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/business-ideas/",
                            "host": ["{{base_url}}"],
                            "path": ["business-ideas", ""]
                        },
                        "description": "Create a business idea with minimum required fields only"
                    },
                    "response": []
                },
                {
                    "name": "Get Single Business Idea",
                    "request": {
                        "method": "GET",
