                            "path": ["progress", ""]
                        },
                        "description": "Get lesson progress for authenticated user"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "3. Chatbot",
            "description": "AI-powered chatbot endpoints",
            "item": [
                {
                    "name": "Start New Conversation",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.collectionVariables.set('session_id', jsonData.session_id);",
                                    "console.log('Session ID saved:', jsonData.session_id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/chat/new/",
                            "host": ["{{base_url}}"],
                            "path": ["chat", "new", ""]
                        },
                        "description": "Start a new chat conversation. The session_id will be automatically saved."
                    },
                    "response": []
                },
                {
                    "name": "Send Chat Message",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"message\": \"How do I start a small business in Bangladesh?\",\n    \"session_id\": \"{{session_id}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/chat/",
                            "host": ["{{base_url}}"],
                            "path": ["chat", ""]
                        },
                        "description": "Send a message to the AI chatbot"
                    },
                    "response": []
                },
                {
                    "name": "Get Conversation History",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/chat/history/{{session_id}}/",
                            "host": ["{{base_url}}"],
                            "path": ["chat", "history", "{{session_id}}", ""]
                        },
                        "description": "Get the history of a conversation"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "4. Business Ideas",
            "description": "Business idea CRUD and simulation endpoints",
            "item": [
                {
                    "name": "Get All Business Ideas",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/business-ideas/",
